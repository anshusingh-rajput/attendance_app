<?xml version="1.0" encoding="utf-8"?>
<!--
  Prevents the login token (stored in SharedPreferences) from being restored
  after an uninstall + reinstall, so every fresh install forces a new login.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
